{
   "compilerOptions": {
      "allowJs": true,
      "checkJs": false,
      "outDir": "./dist",
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": false,
      "baseUrl": ".",
      "paths": {
         "@/*": [
            "src/*"
         ]
      },
   },
   "include": [
      "src/**/*"
   ]
}